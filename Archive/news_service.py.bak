"""
services/news_service.py – Fetches recent news headlines and basic sentiment.
Falls back gracefully if no API key is configured.
"""
from __future__ import annotations
import logging
from typing import List, Tuple

import httpx

import config

logger = logging.getLogger(__name__)


def _simple_sentiment(text: str) -> float:
    """
    Naive keyword-based sentiment score 0..1.
    Replace with a proper NLP model for production.
    """
    text_lower = text.lower()
    positive_words = [
        "beat", "surge", "record", "profit", "growth", "strong", "upgrade",
        "bullish", "rally", "gain", "outperform", "exceed", "positive",
    ]
    negative_words = [
        "miss", "drop", "loss", "decline", "cut", "layoff", "warning",
        "bearish", "crash", "downgrade", "weak", "concern", "risk", "fall",
    ]
    pos = sum(1 for w in positive_words if w in text_lower)
    neg = sum(1 for w in negative_words if w in text_lower)
    total = pos + neg
    if total == 0:
        return 0.5
    return pos / total


async def get_news_sentiment(symbol: str) -> Tuple[float, List[str]]:
    """
    Returns (sentiment_score 0..1, list_of_headlines).
    0.5 = neutral, >0.5 positive, <0.5 negative.
    """
    headlines: List[str] = []

    # Try Alpaca News first (no extra key needed)
    try:
        async with httpx.AsyncClient(timeout=10) as client:
            resp = await client.get(
                "https://data.alpaca.markets/v1beta1/news",
                headers={
                    "APCA-API-KEY-ID": config.ALPACA_API_KEY,
                    "APCA-API-SECRET-KEY": config.ALPACA_SECRET_KEY,
                },
                params={"symbols": symbol, "limit": 10},
            )
            resp.raise_for_status()
            items = resp.json().get("news", [])
            headlines = [item.get("headline", "") for item in items]
    except Exception:
        logger.warning("news_service: Alpaca news unavailable for %s", symbol)

    if not headlines:
        return 0.5, []

    scores = [_simple_sentiment(h) for h in headlines]
    avg = sum(scores) / len(scores)
    return avg, headlines
